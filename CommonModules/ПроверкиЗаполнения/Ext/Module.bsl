// Проверяет заполнение обязательных реквизитов объекта и формирует сообщения пользователю о незаполненных полях
//
// Параметры:
//   Объект - Произвольный - Проверяемый объект
//   СписокРеквизитов - СписокЗначений, Массив из Строка - Имена обязательных реквизитов
//   ИмяОбъекта - Строка - Имя объекта для логирования (необязательно)
//   Отказ - Булево - Признак отмены проведения
Процедура ПроверитьОбязательныеРеквизиты(Объект, СписокРеквизитов, ИмяОбъекта = Неопределено, Отказ) Экспорт
	Если Не ЗначениеЗаполнено(СписокРеквизитов) Тогда
		Возврат;
	КонецЕсли;
	Ошибки = Новый СписокЗначений;
	Для Каждого ИмяРеквизита Из СписокРеквизитов Цикл
		РеквизитЗаполнен = Ложь;
		Попытка
			РеквизитЗаполнен = ЗначениеЗаполнено(Объект[ИмяРеквизита]);
		Исключение
			СтруктураЛога = Новый Структура("Объект,Сообщение,ДопДанные",
			?(ИмяОбъекта = Неопределено, Строка(Объект.Метаданные().Имя), ИмяОбъекта),
			"Ошибка доступа к реквизиту '" + ИмяРеквизита +"'",
			ОписаниеОшибки());
			ЛогированиеПриложений.Ошибка("ПроверкиЗаполнения.ОшибкаДоступаКРеквизиту", СтруктураЛога);
			ВызватьИсключение;
		КонецПопытки;
		Если РеквизитЗаполнен = Ложь Тогда
			ТекстОшибки = "Не заполнен обязательный реквизит '"+ ИмяРеквизита +"'";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,,ИмяРеквизита, "Объект", Отказ);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Проверяет заполненность обязательных реквизитов табличной части объекта и формирует сообщения пользователю об ошибках
//
// Параметры:
//   Объект - Произвольный - Проверяемый объект (документ, справочник и т.п.)
//   ИмяТЧ - Строка - Имя табличной части
//   СписокРеквизитовТЧ - Массив из Строка - Список имен обязательных реквизитов табличной части
//   ИмяОбъекта - Строка - Имя объекта для логирования (необязательно)
//   Отказ - Булево - Признак отказа от записи объекта
Процедура ПроверитьОбязательныеРеквизитыТЧ(Объект, ИмяТЧ, СписокРеквизитовТЧ, ИмяОбъекта = Неопределено, Отказ) Экспорт
	
	Если Не ЗначениеЗаполнено(СписокРеквизитовТЧ) Тогда
		Возврат;
	КонецЕсли;
	МетаданныеТЧ = Объект.Метаданные().ТабличныеЧасти.Найти(ИмяТЧ);
	Если МетаданныеТЧ = Неопределено Тогда 
	    Сообщить("Ошибка: ТЧ с именем " + ИмяТЧ + " не найдена в метаданных!");
	    Возврат; 
	КонецЕсли;
	ТЧ = Объект[ИмяТЧ];
	Если ТЧ.Количество() = 0 Тогда
		ТекстОшибки = "Табличная часть '" + ИмяТЧ + "' пуста";
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,,ИмяТЧ,"Объект", Отказ);
	КонецЕсли;
	НомерСтроки = 0;
	Для Каждого СтрокаТЧ Из ТЧ Цикл 
		НомерСтроки = НомерСтроки + 1;
		Для Каждого ИмяРеквизита Из СписокРеквизитовТЧ Цикл
			РеквизитЗаполнен = Ложь;
			Попытка
				РеквизитЗаполнен = ЗначениеЗаполнено(СтрокаТЧ[ИмяРеквизита]);
			Исключение
				СтруктураЛога = Новый Структура("Объект, Сообщение, ДопДанные",
				?(ИмяОбъекта = Неопределено, Строка(Объект.Метаданные().Имя), ИмяОбъекта),
				"Ошибка доступа к реквизиту '" + ИмяРеквизита + "' ТЧ '" + ИмяТЧ + "' строка " + НомерСтроки,
				ОписаниеОшибки());
				ЛогированиеПриложений.Ошибка("ПроверкиЗаполнения.ОшибкаДоступаКРеквизитуТЧ", СтруктураЛога);
			КонецПопытки;
			Если РеквизитЗаполнен = Ложь Тогда
				ТекстОшибки = "В строке " + НомерСтроки + " табличной части '" + ИмяТЧ +
					"' не заполнен реквизит '" + ИмяРеквизита + "'";
				Путь = "Объект." + ИмяТЧ + "[" + (НомерСтроки - 1) + "]." + ИмяРеквизита;
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,,Путь,, Отказ);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры


// Проверяет заполнение обязательных реквизитов и табличных частей документа перед записью.
// При обнаружении незаполненных обязательных полей устанавливает признак отказа в записи.
//
// Параметры:
//   Источник - ДокументОбъект - документ, перед записью которого выполняется проверка
//   Отказ - Булево - флаг отказа от записи документа. Истина при наличии незаполненных обязательных реквизитов
//   РежимЗаписи - РежимЗаписиДокумента - режим записи документа
//   РежимПроведения - РежимПроведенияДокумента - режим проведения документа
Процедура ДокументПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	ИмяДокумента = Источник.Метаданные().Имя;
	СинонимДокумента = Источник.Метаданные().Синоним;
	ОбязательныеРеквизиты = Неопределено;
	ОбязательныеРеквизитыТЧ = Неопределено;
	
	Попытка
		ОбязательныеРеквизиты = Документы[ИмяДокумента].ОбязательныеРеквизиты();
		ПроверитьОбязательныеРеквизиты(Источник, ОбязательныеРеквизиты, СинонимДокумента, Отказ);
	Исключение
	КонецПопытки;
	
	Попытка
		ОбязательныеРеквизитыТЧ = Документы[ИмяДокумента].ОбязательныеРеквизитыТЧ();
		Для Каждого КлючИЗначение Из ОбязательныеРеквизитыТЧ Цикл
		ПроверитьОбязательныеРеквизитыТЧ(Источник, КлючИЗначение.Ключ, КлючИЗначение.Значение, СинонимДокумента, Отказ);
		КонецЦикла;
	Исключение
	КонецПопытки;
КонецПроцедуры

// Проверяет заполнение обязательных реквизитов и реквизитов табличных частей справочника перед записью.
//
// Параметры:
//   Источник - СправочникОбъект - объект справочника, для которого выполняется проверка
//   Отказ - Булево - при установке значения Истина запись объекта будет отменена
Процедура СправочникПередЗаписью(Источник, Отказ) Экспорт
	ИмяСправочника = Источник.Метаданные().Имя;
	СинонимСправочника = Источник.Метаданные().Синоним;
	ОбязательныеРеквизиты = Неопределено;
	ОбязательныеРеквизитыТЧ = Неопределено;
	
	Попытка
		ОбязательныеРеквизиты = Справочники[ИмяСправочника].ОбязательныеРеквизиты();
		ПроверитьОбязательныеРеквизиты(Источник, ОбязательныеРеквизиты, СинонимСправочника, Отказ);
	Исключение
	КонецПопытки;
	
	Попытка
		ОбязательныеРеквизитыТЧ = Справочники[ИмяСправочника].ОбязательныеРеквизитыТЧ();
		Для Каждого КлючИЗначение Из ОбязательныеРеквизитыТЧ Цикл
		ПроверитьОбязательныеРеквизитыТЧ(Источник, КлючИЗначение.Ключ, КлючИЗначение.Значение, СинонимСправочника, Отказ);
		КонецЦикла;
	Исключение
	КонецПопытки;
КонецПроцедуры