// Добавляет новые записи в регистр очереди интеграции пачкой в одной транзакции.
//
// Параметры:
//   МассивПараметров - Массив из Структура - массив структур для создания записей. 
//                        Структура должна содержать свойства: ТипОбъекта, ID_Внешний, ДанныеJSON
Процедура НовыеЗаписиВРегистрОчедери(МассивПараметров) Экспорт
	НачатьТранзакцию();
	
	Попытка
		Для Каждого Элемент Из МассивПараметров Цикл
			Параметры = Новый Структура;
			Параметры.Вставить("ТипОбъекта", Элемент.ТипОбъекта);
			Параметры.Вставить("ID_Внешний", Элемент.ID_Внешний);
			Параметры.Вставить("ДанныеJSON", Элемент.ДанныеJSON);
			Параметры.Вставить("ДатаСоздания", ТекущаяДата());
            Параметры.Вставить("Статус",       Перечисления.СтатусыОчередиИнтеграции.Новый);
            Параметры.Вставить("ТекстОшибки",  "");
			Параметры.Вставить("Период", ТекущаяДата());
			ЗаписатьВРегитрОчередиИнтеграция(Параметры);
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ДанныеЛога = Новый Структура("Объект, Сообщение, ДопДанные", РегистрыСведений.ОчередьИнтеграции, "Ошибка в записи РС Очереди Интеграции пачкой", ОписаниеОшибки());
		ЛогированиеПриложений.Ошибка("НовыеЗаписиВРегистрОчедери.Ошибка", ДанныеЛога);
	КонецПопытки;
КонецПроцедуры

// Создает новую запись в регистре очереди интеграции с указанными параметрами.
//
// Параметры:
//   ТипОбъекта - Строка - тип объекта интеграции
//   ID_Внешний - Строка - внешний идентификатор объекта
//   ДанныеJSON - Строка - данные в формате JSON
//   Статус - Перечисления.СтатусыОчередиИнтеграции - статус записи, по умолчанию Новый
//   ТекстОшибки - Строка - текст ошибки при обработке записи
Процедура НоваяЗаписьВРегистрОчереди(ТипОбъекта, ID_Внешний, ДанныеJSON, Статус = Неопределено, ТекстОшибки = "") Экспорт
	Параметры = Новый Структура;
	Параметры.Вставить("ТипОбъекта", ТипОбъекта);
	Параметры.Вставить("ID_Внешний", ID_Внешний);
	Параметры.Вставить("ДанныеJSON", ДанныеJSON);
	Параметры.Вставить("ДатаСоздания", ТекущаяДата());
	Параметры.Вставить("Статус", ?(Статус = Неопределено, Перечисления.СтатусыОчередиИнтеграции.Новый, Статус));
	Параметры.Вставить("ТекстОшибки", ТекстОшибки);
	Параметры.Вставить("Период", ТекущаяДата());
	ЗаписатьВРегитрОчередиИнтеграция(Параметры);
КонецПроцедуры

// Записывает или обновляет запись в регистре сведений ОчередьИнтеграции, сохраняя дату создания при перезаписи.
//
// Параметры:
//   СтруктураПараметров - Структура - параметры для записи в регистр
//     * ТипОбъекта - Произвольный - тип интегрируемого объекта
//     * ID_Внешний - Строка - внешний идентификатор объекта
//     * ДанныеJSON - Строка - данные объекта в формате JSON
//     * Статус - Произвольный - статус обработки записи
//     * ТекстОшибки - Строка - текст ошибки при обработке
Процедура ЗаписатьВРегитрОчередиИнтеграция(СтруктураПараметров)
	НаборЗаписи = РегистрыСведений.ОчередьИнтеграции.СоздатьНаборЗаписей();
	НаборЗаписи.Отбор.ТипОбъекта.Установить(СтруктураПараметров.ТипОбъекта);
	НаборЗаписи.Отбор.ID_Внешний.Установить(СтруктураПараметров.ID_Внешний);
    СохранитьДатуСоздания = Неопределено;
	НаборЗаписи.Прочитать();
	Если НаборЗаписи.Количество() > 0 Тогда
        СохранитьДатуСоздания = НаборЗаписи[0].ДатаСоздания;
    КонецЕсли;
	НаборЗаписи.Очистить();
	Запись = НаборЗаписи.Добавить();
	Запись.ТипОбъекта = СтруктураПараметров.ТипОбъекта;
	Запись.ID_Внешний = СтруктураПараметров.ID_Внешний;
	Запись.ДанныеJSON = СтруктураПараметров.ДанныеJSON;
	Запись.Статус = СтруктураПараметров.Статус;
	Запись.ТекстОшибки = СтруктураПараметров.ТекстОшибки;
	
	Если СохранитьДатуСоздания = Неопределено Тогда
		Запись.ДатаСоздания = ТекущаяДатаСеанса();
	Иначе
		Запись.ДатаСоздания = СохранитьДатуСоздания;
	КонецЕсли;
	
	Попытка
		НаборЗаписи.Записать(Истина);
	Исключение
		ДанныеЛога = Новый Структура("Объект, Сообщение, ДопДанные", РегистрыСведений.ОчередьИнтеграции, "Ошибка в записи РС Очереди Интеграции", ОписаниеОшибки());
		ЛогированиеПриложений.Ошибка("ЗаписатьВРегитрОчередиИнтеграция.Ошибка", ДанныеЛога);
	КонецПопытки;
КонецПроцедуры