// Обновляет данные визита на сервере Юклайнс на основе переданной записи JSON
//
// Параметры:
//   Запись - Объект, Структура - запись визита с полями id, staff_id, client, date, last_change_date, payment_status, deleted
//   Успех - Булево - признак успешного выполнения операции
Процедура ОбработатьОбъект_Записи(Запись, Успех) Экспорт
	Успех = Ложь;
	ID_Записи = Строка(Запись.id);
	ПараметрыВизита = Новый Структура;
	ПараметрыВизита.Вставить("ID_Визита", ID_Записи);
	ПараметрыВизита.Вставить("ID_Мастера", Строка(Запись.staff_id));
	ПараметрыВизита.Вставить("ID_Клиента_ЮК", Строка(Запись.client.id));
	ПараметрыВизита.Вставить("ДанныеJSON", РаботаСJSON.Сериализовать(Запись));
	ПараметрыВизита.Вставить("ДатаВизита", РаботаСJSON.СтрокуВДату(Запись.date));
	ПараметрыВизита.Вставить("ПоследняяДатаИзменения", РаботаСJSON.СтрокуВДату(Запись.last_change_date));
	ПараметрыВизита.Вставить("Удален", ?(Запись.Свойство("deleted"), Запись.deleted, Ложь));
	ПараметрыВизита.Вставить("СтатусОплатыВизита", Запись.payment_status);
	Попытка
		ЮклайнсДанныеСервер.ОбновитьДанныеВизита(ПараметрыВизита);
		Успех = Истина;
	Исключение
	КонецПопытки;
	
КонецПроцедуры

// Обрабатывает транзакцию, создавая клиента, услугу и документ оказания услуг.
//
// Параметры:
//   Транзакция - Структура - данные транзакции с полями id, record_id, amount, client
//   Успех - Булево - признак успешности обработки транзакции (выходной параметр)
Процедура ОбработатьОбъект_Транзакции(Транзакция, Успех) Экспорт
	Успех = Ложь;
	
	ID_Транзакции = Строка(Транзакция.id);
	ID_Визита     = Строка(Транзакция.record_id);
	СуммаОплаты   = Транзакция.amount;
	МастерСсылка = ЮклайнсДанныеСервер.ПолучитьМастераИзВизита(ID_Визита);
	
	Телефон = "";
	Имя     = "Неизвестный клиент";
	Если Транзакция.Свойство("client") И Транзакция.client <> Неопределено Тогда
		Транзакция.client.Свойство("phone", Телефон);
		Транзакция.client.Свойство("name",  Имя);
	КонецЕсли;
	
	Если ПустаяСтрока(Телефон) Тогда
		Возврат;
	КонецЕсли;
	
	КлиентСсылка = НайтиИлиСоздатьКлиента(Телефон, Имя);
	
	УслугаID = Строка(Транзакция.sold_item_id);
    УслугаСсылка = НайтиИлиСоздатьУслугу("", 0, УслугаID); 
    
    СтрУслуги = Новый Структура;
    СтрУслуги.Вставить("Номенклатура",  УслугаСсылка);
    СтрУслуги.Вставить("Количество",    1); 
    СтрУслуги.Вставить("Сумма",         Транзакция.amount);
    СтрУслуги.Вставить("ID_Транзакции", ID_Транзакции);
	
	Попытка
		СоздатьИлиОбновитьДокументОказаниеУслуг(ID_Визита, МастерСсылка, КлиентСсылка, СуммаОплаты, СтрУслуги);
		Успех = Истина;
	Исключение
		ВызватьИсключение; 
	КонецПопытки;
	
КонецПроцедуры

// Обрабатывает объект мастера, получая его идентификатор и название для поиска или создания записи в справочнике.
//
// Параметры:
//   Мастер - Произвольный - объект, содержащий свойства id и name
//   Успех - Булево - признак успешной обработки объекта
Процедура ОбработатьОбъект_Мастера(Мастер, Успех) Экспорт
	Успех = Ложь;
	ID_Мастера = Строка(Мастер.id);
	Название = "";
	Мастер.Свойство("name", Название);
	Если НЕ ПустаяСтрока(Название) Тогда
		НайтиИлиСоздатьМастера(ID_Мастера, Название);
		Успех = Истина;
	КонецЕсли;
	
КонецПроцедуры

// Ищет элемент справочника Мастера по идентификатору из YClients. Создает новый элемент, если не найден. Обновляет наименование, если изменилось.
//
// Параметры:
//   ID_Мастера - Строка, Число - идентификатор мастера в системе YClients
//   Имя - Строка - наименование мастера
//
// Возвращаемое значение:
//   СправочникСсылка.Мастера - ссылка на найденный или созданный элемент справочника
Функция НайтиИлиСоздатьМастера(ID_Мастера, Имя) Экспорт
	Ссылка = Справочники.Мастера.НайтиПоРеквизиту("ID_YClients", ID_Мастера);
	
	Если Ссылка.Пустая() Тогда
		Объект = Справочники.Мастера.СоздатьЭлемент();
		Объект.Наименование = Имя;
		Объект.ID_YClients = ID_Мастера;
		Объект.Записать();
		Возврат Объект.Ссылка;
	Иначе
		Если Ссылка.Наименование <> Имя Тогда
			Объект = Ссылка.ПолучитьОбъект();
			Объект.Наименование = Имя;
			Объект.ID_YClients = ID_Мастера;
			Объект.Записать();
		КонецЕсли;
		Возврат Ссылка;
	КонецЕсли;
КонецФункции

// Находит клиента в справочнике по номеру телефона или создает нового клиента, если не найден
//
// Параметры:
//   Телефон - Строка - номер телефона клиента для поиска
//   Имя - Строка - наименование клиента для создания
//
// Возвращаемое значение:
//   СправочникСсылка.Клиенты - ссылка на найденного или созданного клиента
Функция НайтиИлиСоздатьКлиента(Телефон, Имя) Экспорт
	
	Клиент = Справочники.Клиенты.НайтиПоРеквизиту("НомерТелефона", Телефон);
	Если Клиент.Пустая() Тогда
		НовыйКлиент = Справочники.Клиенты.СоздатьЭлемент();
		НовыйКлиент.Наименование = Имя;
		НовыйКлиент.НомерТелефона = Телефон;
		НовыйКлиент.Записать();
		Возврат НовыйКлиент.Ссылка;
	КонецЕсли;
	Возврат Клиент;
	
КонецФункции

// Создает или обновляет документ ОказаниеУслуг для визита и добавляет строку услуги, если она не была добавлена ранее
//
// Параметры:
//   ID_Визита - Строка - идентификатор визита из YClients
//   Мастер - СправочникСсылка.ФизическиеЛица - мастер, выполняющий услуги
//   Клиент - СправочникСсылка.Контрагенты - клиент визита
//   СуммаВизита - Число - общая сумма визита
//   СтрУслуги - Структура - содержит данные об услуге с ключами: Номенклатура (СправочникСсылка.Номенклатура), Количество (Число),
//                 Сумма (Число), ID_Транзакции (Строка)
Процедура СоздатьИлиОбновитьДокументОказаниеУслуг(ID_Визита, Мастер, Клиент, СуммаВизита, СтрУслуги) Экспорт
	
	ДокСсылка = Документы.ОказаниеУслуг.НайтиПоРеквизиту("ID_Визита_YClients", ID_Визита);
    
    Если ДокСсылка.Пустая() Тогда
        ДокОбъект = Документы.ОказаниеУслуг.СоздатьДокумент();
        ДокОбъект.Дата = ТекущаяДатаСеанса();
        ДокОбъект.ID_Визита_YClients = ID_Визита;
        ДокОбъект.Клиент = Клиент;
        ДокОбъект.Мастер = Мастер;
    Иначе
        ДокОбъект = ДокСсылка.ПолучитьОбъект();
    КонецЕсли;
    
    ПараметрыПоиска = Новый Структура("ID_Транзакции_YClients", СтрУслуги.ID_Транзакции);
    НайденныеСтроки = ДокОбъект.Услуги.НайтиСтроки(ПараметрыПоиска);
    
    Если НайденныеСтроки.Количество() = 0 Тогда
        НоваяСтр = ДокОбъект.Услуги.Добавить();
        НоваяСтр.Номенклатура = СтрУслуги.Номенклатура;
        НоваяСтр.Количество   = СтрУслуги.Количество;
        НоваяСтр.Сумма        = СтрУслуги.Сумма;
        НоваяСтр.ID_Транзакции_YClients = СтрУслуги.ID_Транзакции;
        
        ДокОбъект.СуммаНачисления = ДокОбъект.СуммаНачисления + (СтрУслуги.Сумма * Константы.ДоляОплатыВБонусы.Получить());
        
        ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
    КонецЕсли;
	
КонецПроцедуры

// Находит услугу в справочнике Номенклатура по идентификатору из YClients, создает новую при отсутствии или обновляет наименование и цену
//
// Параметры:
//   НазваниеУслуги - Строка - наименование услуги
//   ЦенаУслуги - Число - цена услуги
//   ID_Услуги - Строка - уникальный идентификатор услуги в системе YClients
//
// Возвращаемое значение:
//   СправочникСсылка.Номенклатура - ссылка на найденную или созданную услугу
Функция НайтиИлиСоздатьУслугу(НазваниеУслуги, ЦенаУслуги, ID_Услуги) Экспорт
	Ссылка = Справочники.Номенклатура.НайтиПоРеквизиту("ID_YClients", ID_Услуги);
	
	Если Ссылка.Пустая() Тогда
		Объект = Справочники.Номенклатура.СоздатьЭлемент();
		Объект.Наименование = НазваниеУслуги;
		Объект.ID_YClients  = ID_Услуги;
		 Если Объект.Метаданные().Реквизиты.Найти("Цена") <> Неопределено Тогда
            Объект.Цена = ЦенаУслуги;
        КонецЕсли;
		Объект.Записать();
		Возврат Объект.Ссылка;
	Иначе
		НужноОбновить = Ложь;
        Если Ссылка.Наименование <> НазваниеУслуги Тогда
            НужноОбновить = Истина;
        ИначеЕсли Ссылка.Цена <> ЦенаУслуги Тогда
            НужноОбновить = Истина;
		КонецЕсли;
		
		Если НужноОбновить Тогда
            Объект = Ссылка.ПолучитьОбъект();
            Если НЕ ПустаяСтрока(НазваниеУслуги) Тогда
		        Объект.Наименование = НазваниеУслуги;
		    КонецЕсли;
		    Если ЦенаУслуги > 0 Тогда
		        Объект.Цена = ЦенаУслуги;
		    КонецЕсли;
			Попытка
                Объект.Записать();
			Исключение
				ДанныеЛога = Новый Структура("Объект, Сообщение, ДопДанные", Объект, "Ошибка в обновлении услуги", ОписаниеОшибки());
				ЛогированиеПриложений.Ошибка("НайтиИлиСоздатьУслугу.Ошибка", ДанныеЛога);
			КонецПопытки;
		КонецЕсли;
		Возврат Ссылка;
	КонецЕсли;
КонецФункции
