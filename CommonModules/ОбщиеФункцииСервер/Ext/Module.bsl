// Блокирует измерения регистра по данным из таблицы значений.
//
// Параметры:
// 	ИмяРегистра - Строка - имя регистра, для которого создается блокировка
// 	ТаблицаДанных - ТаблицаЗначений - данные для блокировки измерений
Процедура ЗаблокироватьИзмеренияРегистра(ИмяРегистра, ТаблицаДанных) Экспорт
	Если НЕ ЗначениеЗаполнено(ТаблицаДанных) Тогда
		Возврат;
	КонецЕсли;
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить(ИмяРегистра);
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.ИсточникДанных = ТаблицаДанных;
	Для Каждого Колонка из ТаблицаДанных.Колонки Цикл
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных(Колонка.Имя, Колонка.Имя);
	КонецЦикла;
	Блокировка.Заблокировать();
КонецПроцедуры

// Подготавливает таблицу значений с полями для блокировок регистра и заполняет её данными из объекта или табличной части, затем сворачивает дубликаты.
//
// Параметры:
//   ИмяРегистра - Строка - полное имя объекта метаданного регистра
//   Объект - Произвольный - объект метаданного (документ, справочник) или табличная часть
//   СоответствиеПолей - Структура, ФиксированнаяСтруктура - соответствие имен колонок таблицы значений именам полей объекта, может содержать ключ "ИмяТЧ" для табличной части
//
// Возвращаемое значение:
//   ТаблицаЗначений - свёрнутая таблица значений с полями из СоответствиеПолей
Функция ПодготовитьТаблицуБлокировок(ИмяРегистра, Объект, СоответствиеПолей) Экспорт
	ТЗ = Новый ТаблицаЗначений;
    МдтРегистра = Метаданные.НайтиПоПолномуИмени(ИмяРегистра);
	Для Каждого КлючИЗначение Из СоответствиеПолей Цикл
        ТЗ.Колонки.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;
	ИмяТЧ = "";
	Если СоответствиеПолей.Свойство("ИмяТЧ", ИмяТЧ) Тогда
		Для Каждого СтрокаТЧ из Объект[ИмяТЧ] Цикл
			НоваяСтрока = ТЗ.Добавить();
			Для Каждого Поле из СоответствиеПолей Цикл
				Если Поле.Ключ = "ИмяТЧ" Тогда Продолжить; КонецЕсли;
				Попытка
					НоваяСтрока[Поле.Ключ] = СтрокаТЧ[Поле.Значение];
				Исключение
					НоваяСтрока[Поле.Ключ] = Объект[Поле.Значений];
				КонецПопытки;
			КонецЦикла;
		КонецЦикла;
	Иначе
		НоваяСтрока = ТЗ.Добавить();
		Для Каждого Поле из СоответствиеПолей Цикл
			НоваяСтрока[Поле.Ключ] = Объект[Поле.Значений];
		КонецЦикла;
	КонецЕсли;
	
	МассивКолонок = "";
    Для Каждого Кол Из ТЗ.Колонки Цикл 
        МассивКолонок = МассивКолонок + ?(МассивКолонок="", "", ",") + Кол.Имя; 
    КонецЦикла;
    ТЗ.Свернуть(МассивКолонок);
    
    Возврат ТЗ;
КонецФункции


// Записывает движения по регистрам на основе переданной структуры таблиц.
//
// Параметры:
//   ДокументОбъект - ДокументОбъект - документ, для которого выполняется запись движений
//   СтруктураТаблиц - Структура - ключ - имя регистра, значение - таблица значений с колонками, соответствующими измерениям и ресурсам регистра
Процедура ЗаписатьДвижениеРегистра(ДокументОбъект, СтруктураТаблиц) Экспорт
	Для Каждого КлючИЗначение Из СтруктураТаблиц Цикл
		ИмяРегистра = КлючИЗначение.Ключ;
		ТаблицаДанных = КлючИЗначение.Значение;
		ДвиженияРегистра = ДокументОбъект.Движения[ИмяРегистра];
		ДвиженияРегистра.Записывать = Истина;
		ДвиженияРегистра.Очистить();
		Для Каждого СтрокаДанных из ТаблицаДанных Цикл
			НоваяЗапись = ДвиженияРегистра.Добавить();
			Попытка
				ЗаполнитьЗначенияСвойств(НоваяЗапись, СтрокаДанных);
			Исключение
			ДанныеЛога = Новый Структура("Объект, Сообщение, ДопДанные", Строка(ДокументОбъект.Ссылка), "Ошибка заполнения движения", ОписаниеОшибки());
			ЛогированиеПриложений.Ошибка("ЗаписатьДвижениеРегистра.Ошибка", ДанныеЛога);
			КонецПопытки;
			Если ТаблицаДанных.Колонки.Найти("Период") = Неопределено Тогда
				НоваяЗапись.Период = ДокументОбъект.Дата;
			КонецЕсли;
			НоваяЗапись.Регистратор = ДокументОбъект.Ссылка;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

// Проводит документ с блокировкой измерений регистров и записью движений через подписку на событие ОбработкаПроведения.
//
// Параметры:
//   Источник - ДокументОбъект - проводимый документ
//   Отказ - Булево - признак отмены проведения. Истина - отменить проведение
//   РежимПроведения - РежимПроведенияДокумента - режим проведения документа
Процедура ОбработкаПроведенияПодписка(Источник, Отказ, РежимПроведения) Экспорт 
	Менеджер = Документы[Источник.Метаданные().Имя];
	
	ТаблицаДвижений = Неопределено;
	Попытка
		ТаблицаДвижений = Менеджер.ТаблицаДляПроведения(Источник.Ссылка, Источник.Дата, Отказ);
	Исключение
		ДанныеЛога = Новый Структура("Объект, Сообщение, ДопДанные", Строка(Источник.Метаданные().Имя), "Ошибка получения таблиц для проведения", ОписаниеОшибки());
		ЛогированиеПриложений.Ошибка("ОбработкаПроведенияПодписка.Ошибка", ДанныеЛога);
	КонецПопытки;
	
	Если ТаблицаДвижений <> Неопределено Тогда
		Для Каждого КлючИЗначение Из ТаблицаДвижений Цикл
			МаксПопыток = 3;
			Для Счётчик = 1 По МаксПопыток Цикл
				Попытка
					ЗаблокироватьИзмеренияРегистра(КлючИЗначение.Ключ, КлючИЗначение.Значение);
				Исключение
					Если Счётчик = МаксПопыток Тогда
						Инфо = ИнформацияОбОшибке();
		   			 	ТекстОшибки = КраткоеПредставлениеОшибки(Инфо);
						ЭтоКонфликтБлокировок = Найти(ТекстОшибки, "Conflict") > 0 
		                Или Найти(ТекстОшибки, "Deadlock") > 0
		                Или Найти(ТекстОшибки, "блокировок") > 0;
						
						Если ЭтоКонфликтБлокировок Тогда
							ДанныеЛога = Новый Структура("Объект, Сообщение, ДопДанные", Строка(Источник.Метаданные().Имя), "Взаимоблокировка на регистре: " + КлючИЗначение.Ключ, ОписаниеОшибки());
							ЛогированиеПриложений.Ошибка("ОбработкаПроведенияПодписка.Ошибка", ДанныеЛога);
						Иначе
							ДанныеЛога = Новый Структура("Объект, Сообщение, ДопДанные", Строка(Источник.Метаданные().Имя), "Общая ошибка блокировки", ОписаниеОшибки());
							ЛогированиеПриложений.Ошибка("ОбработкаПроведенияПодписка.Ошибка", ДанныеЛога);
						Отказ = Истина;
						Возврат;
						КонецЕсли;
					КонецЕсли;
				КонецПопытки;
			КонецЦикла;
		КонецЦикла;
		НачатьТранзакцию();
		Попытка
			ЗаписатьДвижениеРегистра(Источник, ТаблицаДвижений);
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ДанныеЛога = Новый Структура("Объект, Сообщение, ДопДанные", Строка(Источник.Метаданные().Имя), "Ошибка при движении", ОписаниеОшибки());
							ЛогированиеПриложений.Ошибка("ОбработкаПроведенияПодписка.Ошибка", ДанныеЛога);
			Отказ = Истина;
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры