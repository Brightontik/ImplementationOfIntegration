// Десериализует JSON-текст в объекты 1С
//
// Параметры:
//   ТекстJSON - Строка - текст в формате JSON
//
// Возвращаемое значение:
//   Структура, Массив, Значение, Неопределено, Булево, Число, Дата - десериализованные данные
Функция Десериализовать(ТекстJSON) Экспорт
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ТекстJSON);
	Данные = ПрочитатьJSON(Чтение); 
	Чтение.Закрыть();
	Возврат Данные;
КонецФункции

// Преобразует значение в формат JSON.
//
// Параметры:
//   ЕдиницаДанных - Строка, Число, Булево, Дата, Структура, Массив, ТаблицаЗначений, ДеревоЗначений, ФиксированнаяСтруктура, ФиксированныйМассив, УникальныйИдентификатор, Null - сериализуемое значение
//
// Возвращаемое значение:
//   Строка - JSON представление переданного значения
Функция Сериализовать(ЕдиницаДанных) Экспорт
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, ЕдиницаДанных);
	СырыеДанные = ЗаписьJSON.Закрыть();
	Возврат СырыеДанные;
КонецФункции

// Преобразует строковое представление даты в тип Дата.
// Извлекает из строки только цифры и пытается создать дату.
//
// Параметры:
//   СтрДата - Строка - строка, содержащая дату в произвольном формате
//
// Возвращаемое значение:
//   Дата - преобразованная дата
//   - '00010101' - если строка пустая или преобразование не удалось
Функция СтрокуВДату(Знач СтрДата) Экспорт
	
	Если ПустаяСтрока(СтрДата) Тогда
		Возврат '00010101';
	КонецЕсли;

	ЧистаяСтрока = "";
	Для Индекс = 1 По СтрДлина(СтрДата) Цикл
		Символ = Сред(СтрДата, Индекс, 1);
		Если Найти("0123456789", Символ) > 0 Тогда
			ЧистаяСтрока = ЧистаяСтрока + Символ;
		КонецЕсли;

		Если СтрДлина(ЧистаяСтрока) = 14 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Попытка
		Возврат Дата(ЧистаяСтрока);
	Исключение
		Возврат '00010101';
	КонецПопытки;
	
КонецФункции